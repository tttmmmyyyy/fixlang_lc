{
    "name": "fixlang-language-client",
    "displayName": "Fix-lang language client",
    "description": "The client of language server protocol for fixlang",
    "version": "0.3.0",
    "publisher": "tttmmmyyyy",
    "license": "MIT",
    "categories": [
        "Programming Languages"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/tttmmmyyyy/fixlang_lc.git"
    },
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.92.0"
    },
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:fixlang"
    ],
    "contributes": {
        "languages": [
            {
                "id": "fixlang",
                "aliases": [
                    "fixlang",
                    "fix-lang"
                ],
                "extensions": [
                    ".fix"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "configuration": {
            "title": "Fix-lang language client settings",
            "properties": {
                "fixLanguageClient.compilerCommand": {
                    "type": "string",
                    "default": "fix",
                    "description": "Command to launch the compiler."
                },
                "fix.analyze.delayMs": {
                    "type": "number",
                    "default": 400,
                    "minimum": 0,
                    "description": "How long (in milliseconds) the language server waits for typing to pause before re-analyzing (diagnostics). 0 disables on-type analysis (it then runs only on save and on initial load)."
                },
                "fix.analyze.onSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether saving a file also triggers analysis (diagnostics)."
                }
            }
        }
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    }
}