{
    "name": "fixlang-language-client",
    "displayName": "Fix-lang language client",
    "description": "The client of language server protocol for fixlang",
    "version": "0.2.0",
    "publisher": "tttmmmyyyy",
    "license": "MIT",
    "categories": [
        "Programming Languages"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/tttmmmyyyy/fixlang_lc.git"
    },
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.92.0"
    },
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:fixlang"
    ],
    "contributes": {
        "languages": [
            {
                "id": "fixlang",
                "aliases": [
                    "fixlang",
                    "fix-lang"
                ],
                "extensions": [
                    ".fix"
                ]
            }
        ],
        "configuration": {
            "title": "Fix-lang language client settings",
            "properties": {
                "fixLanguageClient.compilerCommand": {
                    "type": "string",
                    "default": "fix",
                    "description": "Command to launch the compiler."
                }
            }
        }
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    }
}