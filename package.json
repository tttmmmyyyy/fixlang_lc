{
    "name": "fixlang",
    "displayName": "Fix-lang",
    "description": "Fix-lang support for VSCode",
    "version": "0.3.0",
    "publisher": "tttmmmyyyy",
    "license": "MIT",
    "categories": [
        "Programming Languages"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/tttmmmyyyy/fixlang_lc.git"
    },
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.92.0"
    },
    "main": "./extension.js",
    "contributes": {
        "languages": [
            {
                "id": "fixlang",
                "aliases": [
                    "fixlang",
                    "fix-lang"
                ],
                "extensions": [
                    ".fix"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "fixlang",
                "scopeName": "source.fix",
                "path": "./syntaxes/fixlang.tmLanguage.json"
            }
        ],
        "configuration": {
            "title": "Fix-lang",
            "properties": {
                "fixlang.compilerCommand": {
                    "type": "string",
                    "default": "fix",
                    "description": "Command to launch the compiler."
                }
            }
        }
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    }
}
